<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pet RPG - Map Editor</title>
    <style>
        :root {
            --bg0: #000814; 
            --bg1: #001d3d; 
            --bg2: #003566;
            --p0: #0077b6; 
            --p1: #90e0ef; 
            --w: #caf0f8;
        }

        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg0);
            color: var(--w);
            margin: 0;
            padding: 20px;
            display: flex;
            gap: 20px;
            height: 100vh;
        }

        .sidebar {
            width: 360px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            background: var(--bg1);
            padding: 20px;
            border-radius: 12px;
            border: 2px solid var(--p0);
            overflow-y: auto;
        }

        h2, h3 { margin: 0; color: var(--p1); }

        .editor-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: auto;
            background: rgba(0,0,0,0.5);
            border-radius: 12px;
            padding: 20px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(30, 24px);
            grid-template-rows: repeat(30, 24px);
            gap: 1px;
            background: #111;
            padding: 4px;
            border: 2px solid var(--p0);
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
            user-select: none;
        }

        .cell {
            width: 24px;
            height: 24px;
            background: #000;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
        }

        /* TILE STYLES MATCHING THE GAME */
        .tile-grass { background: #27ae60; border: 1px solid rgba(0,0,0,0.1); }
        .tile-tall_grass { background: #1e8449; border: 1px solid rgba(0,0,0,0.1); }
        .tile-wall { background: #4a5568; border: 1px solid #2d3748; }
        .tile-water { background: #3498db; border: 1px solid rgba(0,0,0,0.1); }
        .tile-planks { background: #8b5a2b; border: 1px solid rgba(0,0,0,0.1); }
        .tile-route { background: #f1c40f; border: 1px solid #d4ac0d; }
        .tile-gate { background: #d35400; border: 1px solid #ba4a00; }
        .tile-gate::after { content: "🚪"; }
        .tile-prev_gate { background: #8e44ad; border: 1px solid #732d91; }
        .tile-prev_gate::after { content: "◀️"; }
        .tile-next_gate { background: #d35400; border: 1px solid #ba4a00; }
        .tile-next_gate::after { content: "▶️"; }

        .palette {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .palette-btn {
            padding: 8px 10px;
            border: 2px solid transparent;
            border-radius: 6px;
            color: #fff;
            font-weight: bold;
            font-size: 12px;
            cursor: pointer;
            text-align: left;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .palette-btn.active {
            border-color: #fff;
            box-shadow: 0 0 10px rgba(255,255,255,0.8);
        }

        .action-row {
            display: flex;
            gap: 8px;
        }

        button.action-btn {
            flex: 1;
            background: var(--p0);
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            transition: 0.2s;
        }

        button.action-btn:hover {
            background: var(--p1);
            color: #000;
        }

        textarea {
            width: 100%;
            height: 180px;
            background: var(--bg2);
            color: #fff;
            border: 1px solid var(--p0);
            border-radius: 6px;
            font-family: monospace;
            font-size: 11px;
            padding: 8px;
            resize: vertical;
            white-space: pre;
        }
    </style>
</head>
<body>

<div class="sidebar">
    <h2>Map Editor</h2>
    <small>Click or drag on the grid to paint tiles.</small>

    <h3>Palette</h3>
    <div class="palette" id="palette"></div>

    <h3>Quick Actions</h3>
    <div class="action-row">
        <button class="action-btn" onclick="fillGrid()">Fill All</button>
        <button class="action-btn" onclick="addWallsBorder()">Add Wall Border</button>
    </div>

    <h3>Map Code Export / Import</h3>
    <input type="text" id="mapVarName" value="route2Map" style="padding: 8px; background: var(--bg2); border: 1px solid var(--p0); color: #fff; border-radius: 6px;" placeholder="Variable Name (e.g. route2Map)">
    
    <div class="action-row">
        <button class="action-btn" onclick="exportCode()" style="background:#2ecc71;">Generate Code</button>
        <button class="action-btn" onclick="importCode()" style="background:#e67e22;">Load Code</button>
    </div>

    <textarea id="outputCode" placeholder="Generated JavaScript map code will appear here..."></textarea>
    <button class="action-btn" onclick="copyCode()" style="background:var(--p2); border: 1px solid var(--p0);">📋 Copy to Clipboard</button>
</div>

<div class="editor-area">
    <div class="grid" id="grid"></div>
</div>

<script>
    const MAP_SIZE = 30;
    let selectedTile = 'grass';
    let isMouseDown = false;

    // 30x30 Array initialized with 'grass'
    let mapData = Array.from({ length: MAP_SIZE }, () => Array(MAP_SIZE).fill('grass'));

    const TILES = [
        { id: 'grass', name: 'Grass', class: 'tile-grass' },
        { id: 'tall_grass', name: 'Tall Grass', class: 'tile-tall_grass' },
        { id: 'wall', name: 'Wall / Tree', class: 'tile-wall' },
        { id: 'water', name: 'Water', class: 'tile-water' },
        { id: 'planks', name: 'Planks', class: 'tile-planks' },
        { id: 'route', name: 'Route Path', class: 'tile-route' },
        { id: 'gate', name: 'Gate (General)', class: 'tile-gate' },
        { id: 'prev_gate', name: 'Prev Gate ◀️', class: 'tile-prev_gate' },
        { id: 'next_gate', name: 'Next Gate ▶️', class: 'tile-next_gate' }
    ];

    window.addEventListener('load', () => {
        renderPalette();
        initGrid();
        addWallsBorder();
        
        document.body.addEventListener('mousedown', () => isMouseDown = true);
        document.body.addEventListener('mouseup', () => isMouseDown = false);
    });

    function renderPalette() {
        const paletteEl = document.getElementById('palette');
        paletteEl.innerHTML = '';

        TILES.forEach(tile => {
            const btn = document.createElement('div');
            btn.className = `palette-btn ${tile.class} ${tile.id === selectedTile ? 'active' : ''}`;
            btn.innerText = tile.name;
            btn.onclick = () => {
                selectedTile = tile.id;
                document.querySelectorAll('.palette-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            };
            paletteEl.appendChild(btn);
        });
    }

    function initGrid() {
        const gridEl = document.getElementById('grid');
        gridEl.innerHTML = '';

        for (let r = 0; r < MAP_SIZE; r++) {
            for (let c = 0; c < MAP_SIZE; c++) {
                const cell = document.createElement('div');
                cell.className = `cell tile-${mapData[r][c]}`;
                cell.dataset.r = r;
                cell.dataset.c = c;

                cell.addEventListener('mousedown', () => paintCell(r, c, cell));
                cell.addEventListener('mouseenter', () => {
                    if (isMouseDown) paintCell(r, c, cell);
                });

                gridEl.appendChild(cell);
            }
        }
    }

    function paintCell(r, c, cellEl) {
        mapData[r][c] = selectedTile;
        cellEl.className = `cell tile-${selectedTile}`;
    }

    function fillGrid() {
        for (let r = 0; r < MAP_SIZE; r++) {
            for (let c = 0; c < MAP_SIZE; c++) {
                mapData[r][c] = selectedTile;
            }
        }
        initGrid();
    }

    function addWallsBorder() {
        for (let r = 0; r < MAP_SIZE; r++) {
            for (let c = 0; c < MAP_SIZE; c++) {
                if (r === 0 || r === MAP_SIZE - 1 || c === 0 || c === MAP_SIZE - 1) {
                    mapData[r][c] = 'wall';
                }
            }
        }
        initGrid();
    }

    function exportCode() {
        const varName = document.getElementById('mapVarName').value.trim() || 'route2Map';
        let code = `const ${varName} = [\n`;
        for (let r = 0; r < MAP_SIZE; r++) {
            const rowStr = mapData[r].map(t => `'${t}'`).join(',');
            code += `    [${rowStr}]${r < MAP_SIZE - 1 ? ',' : ''}\n`;
        }
        code += `];`;
        document.getElementById('outputCode').value = code;
    }

    function importCode() {
        const code = document.getElementById('outputCode').value.trim();
        if (!code) return alert("Please paste map code into the text area first!");

        try {
            // Extract matrix array from JavaScript code string
            const arrayMatch = code.match(/\[\s*\[[\s\S]*\]\s*\]/);
            if (!arrayMatch) throw new Error("No array structure found.");
            
            // Clean up single quotes to double quotes for standard JSON parsing
            const jsonString = arrayMatch[0].replace(/'/g, '"');
            const parsedArray = JSON.parse(jsonString);

            if (Array.isArray(parsedArray) && parsedArray.length === MAP_SIZE && parsedArray[0].length === MAP_SIZE) {
                mapData = parsedArray;
                initGrid();
                alert("Map loaded successfully!");
            } else {
                alert(`Loaded map matrix size must be exactly 30x30 (Found: ${parsedArray.length}x${parsedArray[0].length}).`);
            }
        } catch (err) {
            alert("Failed to parse map code. Make sure it matches standard array format: const routeName = [['wall', ...], ...]");
        }
    }

    function copyCode() {
        const textarea = document.getElementById('outputCode');
        textarea.select();
        document.execCommand('copy');
        alert("Map code copied to clipboard!");
    }
</script>
</body>
</html>
