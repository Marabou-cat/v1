<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Map Editor - Pet Catching RPG</title>
    <style>
        :root {
            --bg0: #000814; 
            --bg1: #001d3d; 
            --bg2: #003566;
            --p0: #0077b6; 
            --p1: #90e0ef; 
            --w: #caf0f8;
            --r: 8px;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg0);
            color: var(--w);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        h1 { color: var(--p1); margin-bottom: 10px; }

        .toolbar {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            background: var(--bg1);
            padding: 15px;
            border-radius: var(--r);
            border: 2px solid var(--p0);
            flex-wrap: wrap;
            justify-content: center;
        }

        .brush-btn {
            background: var(--bg2);
            color: white;
            border: 2px solid transparent;
            padding: 10px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.2s;
        }

        .brush-btn:hover { filter: brightness(1.2); }
        .brush-btn.active { border-color: var(--p1); box-shadow: 0 0 10px var(--p0); }

        /* Brush Colors */
        .brush-grass { background: #27ae60; }
        .brush-tall_grass { background: #1e8449; }
        .brush-wall { background: #4a5568; }
        .brush-route { background: #f1c40f; color: black; }
        .brush-gate_next { background: #d35400; }
        .brush-gate_prev { background: #c0392b; }

        .editor-container {
            display: grid;
            grid-template-columns: repeat(30, 20px);
            grid-template-rows: repeat(30, 20px);
            gap: 1px;
            background: #000;
            border: 4px solid var(--p0);
            user-select: none;
        }

        .cell {
            width: 20px;
            height: 20px;
            cursor: crosshair;
        }

        /* Tile visuals */
        .cell.grass { background: #27ae60; }
        .cell.tall_grass { background: #1e8449; }
        .cell.wall { background: #4a5568; }
        .cell.route { background: #f1c40f; }
        
        .cell.gate_next { 
            background: #d35400; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-size: 10px; 
        }
        .cell.gate_next::after { content: "➡️"; }

        .cell.gate_prev { 
            background: #c0392b; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-size: 10px; 
        }
        .cell.gate_prev::after { content: "⬅️"; }

        .action-row {
            margin-top: 20px;
            display: flex;
            gap: 15px;
            width: 100%;
            max-width: 630px;
        }

        .btn-ready {
            flex: 1;
            background: #2ecc71;
            color: white;
            border: none;
            padding: 15px;
            border-radius: var(--r);
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-ready:hover { background: #27ae60; }
        .btn-clear { background: #e74c3c; color: white; border: none; padding: 15px; border-radius: var(--r); font-weight: bold; cursor: pointer; }
        .btn-clear:hover { background: #c0392b; }

        .output-container {
            margin-top: 20px;
            width: 100%;
            max-width: 800px;
            display: none;
        }

        textarea {
            width: 100%;
            height: 250px;
            background: #111;
            color: #2ecc71;
            border: 2px solid var(--p0);
            border-radius: var(--r);
            padding: 10px;
            font-family: monospace;
            font-size: 14px;
            resize: vertical;
        }
    </style>
</head>
<body>

    <h1>RPG Map Editor</h1>
    
    <div class="toolbar" id="toolbar">
        <button class="brush-btn brush-grass active" onclick="setBrush('grass')">Grass</button>
        <button class="brush-btn brush-tall_grass" onclick="setBrush('tall_grass')">Tall Grass</button>
        <button class="brush-btn brush-wall" onclick="setBrush('wall')">Wall</button>
        <button class="brush-btn brush-route" onclick="setBrush('route')">Route</button>
        <button class="brush-btn brush-gate_prev" onclick="setBrush('gate_prev')">Gate Prev ⬅️</button>
        <button class="brush-btn brush-gate_next" onclick="setBrush('gate_next')">Gate Next ➡️</button>
    </div>

    <div class="editor-container" id="grid"></div>

    <div class="action-row">
        <button class="btn-clear" onclick="clearMap()">🗑️ Clear Map</button>
        <button class="btn-ready" onclick="generateMap()">✅ Ready (Generate Code)</button>
    </div>

    <div class="output-container" id="outputContainer">
        <h3 style="color: var(--p1); margin-bottom: 5px;">Generated Map Array:</h3>
        <p style="font-size: 14px; margin-top: 0; color: #aaa;">Copy this code and paste it into your game file array.</p>
        <textarea id="outputCode" readonly></textarea>
    </div>

    <script>
        const MAP_SIZE = 30;
        let currentBrush = 'grass';
        let isMouseDown = false;
        
        let mapData = Array.from({ length: MAP_SIZE }, () => Array(MAP_SIZE).fill('grass'));

        document.body.addEventListener('mousedown', () => isMouseDown = true);
        document.body.addEventListener('mouseup', () => isMouseDown = false);

        const gridElement = document.getElementById('grid');
        
        function drawGrid() {
            gridElement.innerHTML = '';
            for (let r = 0; r < MAP_SIZE; r++) {
                for (let c = 0; c < MAP_SIZE; c++) {
                    const cell = document.createElement('div');
                    cell.className = `cell ${mapData[r][c]}`;
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    
                    cell.addEventListener('mousedown', (e) => paintCell(e.target));
                    cell.addEventListener('mouseenter', (e) => {
                        if (isMouseDown) paintCell(e.target);
                    });
                    
                    gridElement.appendChild(cell);
                }
            }
        }

        function paintCell(element) {
            const r = element.dataset.row;
            const c = element.dataset.col;
            
            mapData[r][c] = currentBrush;
            element.className = `cell ${currentBrush}`;
        }

        function setBrush(brushType) {
            currentBrush = brushType;
            document.querySelectorAll('.brush-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelector(`.brush-${brushType}`).classList.add('active');
        }

        function clearMap() {
            if(confirm("Are you sure you want to reset the map to all grass?")) {
                mapData = Array.from({ length: MAP_SIZE }, () => Array(MAP_SIZE).fill('grass'));
                drawGrid();
                document.getElementById('outputContainer').style.display = 'none';
            }
        }

        function generateMap() {
            let code = "const customMap = [\n";
            for(let r = 0; r < MAP_SIZE; r++) {
                const rowString = mapData[r].map(tile => `'${tile}'`).join(', ');
                code += `    [${rowString}]`;
                if(r < MAP_SIZE - 1) {
                    code += ",\n";
                } else {
                    code += "\n";
                }
            }
            code += "];";
            
            document.getElementById('outputContainer').style.display = 'block';
            document.getElementById('outputCode').value = code;
            document.getElementById('outputContainer').scrollIntoView({ behavior: 'smooth' });
        }

        drawGrid();
    </script>
</body>
</html>
